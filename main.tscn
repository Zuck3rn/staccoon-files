[sub_resource type="GDScript" id="GDScript_h2yge"]
script/source = "extends Node2D

const objectTypes = [\"jetpack\", \"umbrella\", \"manhole\", \"divingR\", \"divingL\"]
var object : stackObject
var shopPrompt = false
var shopIsOpen = false
var shopTheme : AudioStreamWAV = preload(\"res://audio/ShopTheme.wav\")
var mainTheme : AudioStreamMP3 = preload(\"res://audio/Staccoon.mp3\")
var gameOver : AudioStreamMP3 = preload(\"res://audio/Game Over.mp3\")
var coins := 0
var coinAdd := 0

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	$Music.set_stream(mainTheme)
	$Music.play()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	position.y = lerp(position.y, (-$Player.grounded_y + 350 + ($Player.grounded_y - $Player.position.y) * 0.3)*2, 0.4)
	if Input.is_action_just_pressed(\"escape\"):
		if shopIsOpen:
			shopIsOpen = false
			$Music.set_stream(mainTheme)
			$Music.play()
		else:
			$\"UI/Pause Screen\".visible = not $\"UI/Pause Screen\".visible
	if shopPrompt and Input.is_action_just_pressed(\"accept\"):
		print(\"Opening Shop\")
		openShop.emit()
		$SFX.play()
		$Music.set_stream(shopTheme)
		$Music.play()
		shopPrompt = false
		$UI/GameUI/PopUp.visible = false
		shopIsOpen = true
		$Player.position = $Shop.position
		
	if Input.is_action_just_pressed(\"quit\"):
		$Music.set_stream(gameOver)
		$Music.play()
		$SFX.stop()
		$UI/GameOver.visible = true
		
	if Input.is_anything_pressed() and $UI/Tutorial/TutorialTimeOut.is_stopped():
		$UI/Tutorial/TutorialTimeOut.start()
	elif $UI/Tutorial.visible and not Input.is_anything_pressed():
		$UI/Tutorial/TutorialTimeOut.stop()

signal openShop()

func _on_box_body_entered(body: Node2D) -> void:
	if abs(position.y - ((-$Player.grounded_y + 350 + ($Player.grounded_y - $Player.position.y) * 0.3)*2)) < 100:
		object = body.get_child(0)
		print(object.get_type())
		if object.get_type().match(\"none\"):
			var newType = objectTypes.pick_random()
			if $Stack.stack.is_empty() or newType.match($Stack.stack[-1]):
				newType = objectTypes.pick_random()
			object.set_type(newType)


func _on_shop_body_entered(body: Node2D) -> void:
	if body.name.match(\"Player\"):
		$UI/GameUI/PopUp.visible = true
		shopPrompt = true


func _on_shop_body_exited(_body: Node2D) -> void:
	$UI/GameUI/PopUp.visible = false
	shopPrompt = false


func _on_player_stack_cool_down_timeout() -> void:
	$Player.position = $\"Spawn Point\".position
	$Player.grounded_y = $Player.position.y
	match $Stack.stack[-1]:
		\"umbrella\":
			coins += 3
		\"manhole\":
			coins += 4
		\"jetpack\":
			coins += 1
		\"divingL\":
			coins += 2
		\"divingR\":
			coins += 2
	coins += coinAdd
	$UI/GameUI/Coins/CoinCount.text = \"Coins: \" + str(coins)
	$Player.grounded_y = $Player.position.y
	position.y = -$Player.position.y + 350



func _on_death_zone_body_entered(_body: Node2D) -> void:
	$Music.set_stream(gameOver)
	$Music.play()
	$SFX.stop()
	$UI/GameOver.visible = true
	openShop.emit()

func buyItem(index: int) -> void:
	var price = 0
	match $UI/InShop.shopList[index]:
		\"AA Battery\":
			price = 1
		\"Speedy Shoes\":
			price = 4
		\"Pogo Stick\":
			price = 20
		\"God Mode\":
			price = 99
		\"Headband\":
			price = 2
		\"Magnet\":
			price = 6
		_:
			price = 0
	if coins >= price:
		coins -= price
		$UI/GameUI/Coins/CoinCount.text = \"Coins: \" + str(coins)
		match $UI/InShop.shopList[index]:
			\"AA Battery\":
				$Player.dashAdd += 100
			\"Speedy Shoes\":
				$Player.speedMult *= 2
			\"Pogo Stick\":
				$Player.maxJumpAdd += 1
			\"God Mode\":
				$Player.speedMult *= 10
				$Player.jumpMult *= 10
				$Player.dashMult *= 10
			\"Headband\":
				$Player.jumpAdd += 50
			\"Magnet\":
				coinAdd += 1
			_:
				price = 0
		$UI/InShop.shopList[index] = \"\"
		$UI/InShop.updateShop(index)

func _on_item_1_pressed() -> void:
	buyItem(0)
	


func _on_tutorial_time_out_timeout() -> void:
	$UI/Tutorial.visible = false


func _on_item_2_pressed() -> void:
	buyItem(1)


func _on_item_3_pressed() -> void:
	buyItem(2)
"

